# ─── Origin Repairs — Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git.

# ── Resend (email) ───────────────────────────────────────────────────────────
# Required for booking confirmations and contact form emails.
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month)
# 2. Verify your domain: originrepairs.co.uk (add the DNS TXT record)
# 3. Create an API key and paste it below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Origin Repairs <repairs@originrepairs.co.uk>

# ── Site URL ─────────────────────────────────────────────────────────────────
# Used for absolute URLs in emails and OG tags.
NEXT_PUBLIC_SITE_URL=https://originrepairs.co.uk

# Approve production operations only after the owner and legal checklist is
# complete. Preview deployments remain non-operational even with this file.
PRODUCTION_OPERATIONS_ENABLED=false

# Only the canonical production deployment should be indexable.
SITE_INDEXING_ENABLED=false
SITE_CONTENT_LAST_MODIFIED=2026-07-29

# ── Owner-verified business features ─────────────────────────────────────────
# Set a feature to true only after the owner has confirmed it is operational.
NEXT_PUBLIC_BOOKING_ENABLED=true
NEXT_PUBLIC_WALK_INS_ENABLED=false
NEXT_PUBLIC_MAIL_IN_ENABLED=false
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_CUSTOMER_ACCOUNTS_ENABLED=true

# Preferred: at least 32 random characters. Used to encrypt short-lived account
# links and customer sessions. If omitted, the private Resend key is used.
AUTH_SECRET=
# Trusted public origin used in emailed sign-in links.
AUTH_BASE_URL=https://originrepairs.co.uk

# ── Verified trust profiles ──────────────────────────────────────────────────
# Leave blank to hide the corresponding link or review UI.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_TRUSTPILOT_URL=

# ── Email delivery ───────────────────────────────────────────────────────────
# Real email is disabled unless explicitly enabled. Preview email requires both
# flags so staging cannot contact customers by accident.
EMAILS_ENABLED=false
ALLOW_PREVIEW_EMAILS=false

# Optional Cloudflare Turnstile. Leave blank to disable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
