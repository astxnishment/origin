# Origin Repairs — non-secret local configuration example
# Copy to .env.local; never commit real credentials. Current migration is
# contact-only. Cloudflare wrappers use scripts/cloudflare-environment.mjs
# for build/runtime flags and override conflicting local values.

NEXT_PUBLIC_SITE_URL=https://originrepairs.com
# Generic is suitable for direct local Next.js requests. The Cloudflare
# profile sets HOSTING_PROVIDER=cloudflare and requires CF-Connecting-IP.
HOSTING_PROVIDER=generic
DEPLOYMENT_ENV=preview
# Vercel supplies VERCEL_ENV; do not copy it into a Cloudflare deployment.
NEXT_PUBLIC_CONTACT_ONLY=true
PRODUCTION_OPERATIONS_ENABLED=false
SITE_INDEXING_ENABLED=false
SITE_CONTENT_LAST_MODIFIED=2026-09-29

# All public services remain off during the migration. Setting these true
# while contact-only is true is rejected by the production readiness gate.
NEXT_PUBLIC_BOOKING_ENABLED=false
NEXT_PUBLIC_WALK_INS_ENABLED=false
NEXT_PUBLIC_MAIL_IN_ENABLED=false
NEXT_PUBLIC_TRACKING_ENABLED=false
NEXT_PUBLIC_CUSTOMER_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_LIVE_CHAT_ENABLED=false

# Real email and database writes are separately controlled.
EMAILS_ENABLED=false
ALLOW_PREVIEW_EMAILS=false
REPAIR_WRITES_ENABLED=false
ALLOW_PREVIEW_REPAIR_WRITES=false

# Future email setup: verify a sending address at originrepairs.com with
# Resend, then configure it explicitly. No mailbox is created by this file.
# The existing business contact mailbox is unchanged pending confirmation.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile: configure both together for the canonical domain.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostgreSQL repairs. Never expose credentials in NEXT_PUBLIC variables.
# Workers request-scoped connections/Hyperdrive setup are still pending.
DATABASE_URL=
STAFF_EMAILS=

# Existing custom email-link auth, retained but disabled in contact-only mode.
# Use a dedicated >=32-character secret for controlled local account tests.
AUTH_SECRET=
AUTH_BASE_URL=https://originrepairs.com

# Clerk is planned, not implemented. Keys alone do not switch authentication.
# Keep its secret server-only. Do not enable accounts until the session
# adapter, middleware/CSP and private-data permissions pass runtime checks.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Existing Tawk adapter, retained but disabled. These are public IDs, not
# keys for the planned Cloudflare-hosted human chat inbox. That replacement
# still needs Durable Object storage, staff permissions and real delivery.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Leave unverified public profile links blank.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_TRUSTPILOT_URL=

# For full-feature LOCAL tests only: set contact-only=false, enable the
# required public features and use a separate local database with
# ALLOW_PREVIEW_REPAIR_WRITES=true. Never use live customer credentials.
# See docs/CLOUDFLARE.md and .github/workflows/quality.yml for test profiles.
